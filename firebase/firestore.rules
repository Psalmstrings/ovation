rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contact and consultation enquiries:
    // Anyone can submit. Only authenticated admins can read/update/delete.
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.fullName != null
                    && request.resource.data.email != null
                    && request.resource.data.phone != null;
      allow read, update, delete: if request.auth != null;
    }

    // Music class bookings:
    // Anyone can submit a booking. Only authenticated admins can read/update/delete.
    // Students cannot read other students bookings.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.fullName != null
                    && request.resource.data.email != null
                    && request.resource.data.instrument != null
                    && request.resource.data.bookingReference != null;
      allow read, update, delete: if request.auth != null;
    }

    // Services and catalog content: public read, admin write.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users collection: each user can read/write their own doc; admin reads all.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }
  }
}
