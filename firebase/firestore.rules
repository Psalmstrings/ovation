rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contact and consultation enquiries:
    // Anyone can submit (create) an enquiry.
    // Only authenticated admin users can read, update, or delete.
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.fullName != null 
                    && request.resource.data.email != null
                    && request.resource.data.phone != null;
      allow read, update, delete: if request.auth != null;
    }

    // Services and catalog content:
    // Public read access for website rendering.
    // Admin write access.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
